{
  "name": "moesekai-story-studio",
  "version": "0.4.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/StarMoe-org/moesekai-story-studio.git"
  },
  "homepage": "https://github.com/StarMoe-org/moesekai-story-studio",
  "bugs": {
    "url": "https://github.com/StarMoe-org/moesekai-story-studio/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "version:show": "bun scripts/version.ts show",
    "version:check": "bun scripts/version.ts check",
    "version:bump": "bun scripts/version.ts bump",
    "publish:packages": "bun scripts/publish-packages.ts",
    "sync:cnb-release": "bun scripts/sync-cnb-release.ts",
    "build:core": "bun run --cwd packages/story-core build",
    "build:editor": "bun run --cwd packages/story-editor build",
    "build:agent": "bun run --cwd packages/story-agent build",
    "build:packages": "bun run build:core && bun run build:agent && bun run build:editor",
    "build:skill": "bun skills/moesekai-story-script/scripts/build-skill-core.ts",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "package:desktop": "bun run build:packages && bun run build:skill && bun run --cwd apps/desktop package",
    "build": "bun run build:packages && bun run build:skill && bun run build:desktop",
    "test:core": "bun run --cwd packages/story-core test",
    "test:editor": "bun run --cwd packages/story-editor test",
    "test:agent": "bun run --cwd packages/story-agent test",
    "test:desktop": "bun run --cwd apps/desktop test",
    "test:release": "bun test tests/release-tooling.test.ts",
    "test": "bun run test:core && bun run test:editor && bun run test:agent && bun run test:desktop && bun run test:release",
    "typecheck:core": "bun run --cwd packages/story-core typecheck",
    "typecheck:editor": "bun run --cwd packages/story-editor typecheck",
    "typecheck:agent": "bun run --cwd packages/story-agent typecheck",
    "typecheck:desktop": "bun run --cwd apps/desktop typecheck",
    "typecheck": "bun run typecheck:core && bun run typecheck:editor && bun run typecheck:agent && bun run typecheck:desktop"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
