{
  "name": "@moesekai/story-studio-desktop",
  "version": "0.1.1",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "description": "MoeSekai Story Studio — Electron desktop application built with Bun",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "build:main": "bun run scripts/build.ts --main-only",
    "build:renderer": "bunx vite build",
    "start": "bunx electron .",
    "smoke": "bun run scripts/smoke.ts",
    "capture-ui": "bun run scripts/capture-ui.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "package": "bun run build && bunx electron-builder --config electron-builder.yml",
    "package:dir": "bun run build && bunx electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@moesekai/story-agent": "workspace:*",
    "@moesekai/story-core": "workspace:*",
    "@moesekai/story-editor": "workspace:*",
    "framer-motion": "^12.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "35.7.5",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^7.3.8"
  }
}
